<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp3.MainPage"
    Title="Gracze">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="8">

            <Label Text="Menadżer graczy"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="Dodawanie gracza"
                   FontAttributes="Bold" />

            <Entry Placeholder="Nazwa gracza"
                   Text="{Binding PlayerName}" />

            <Entry Placeholder="Poziom gracza"
                   Keyboard="Numeric"
                   Text="{Binding PlayerLevel}" />

            <Button Text="Dodaj gracza"
                    Command="{Binding AddPlayerCommandButton}" />

            <Label Text="Lista graczy"
                   FontAttributes="Bold"
                   Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding Players}"
                            HeightRequest="200">
                <CollectionView.EmptyView>
                    <Label Text="Brak graczy na liście." />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5"
                              ColumnDefinitions="50,*,100">
                            <Label Grid.Column="0"
                                   Text="{Binding Id}" />

                            <Label Grid.Column="1"
                                   Text="{Binding Name}" />

                            <Label Grid.Column="2"
                                   Text="{Binding Level, StringFormat='Poziom: {0}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Wyszukiwanie"
                   FontAttributes="Bold"
                   Margin="0,8,0,0" />

            <Entry Placeholder="Id gracza"
                   Keyboard="Numeric"
                   Text="{Binding PlayerId}" />

            <Button Text="Szukaj"
                    Command="{Binding FindPlayerCommandButton}" />

            <Label Text="Edycja gracza"
                   FontAttributes="Bold"
                   Margin="0,8,0,0" />

            <Entry Placeholder="Id gracza do edycji"
                   Keyboard="Numeric"
                   Text="{Binding EditPlayerId}" />

            <Entry Placeholder="Nowa nazwa"
                   Text="{Binding EditPlayerName}" />

            <Entry Placeholder="Nowy poziom"
                   Keyboard="Numeric"
                   Text="{Binding EditPlayerLevel}" />

            <Button Text="Zapisz zmiany"
                    Command="{Binding EditPlayerCommandButton}" />

            <Label Text="Usuwanie gracza"
                   FontAttributes="Bold"
                   Margin="0,8,0,0" />

            <Entry Placeholder="Id gracza do usunięcia"
                   Keyboard="Numeric"
                   Text="{Binding DeletePlayerId}" />

            <Button Text="Usuń gracza"
                    Command="{Binding DeletePlayerCommandButton}" />

            <Label Text="{Binding SearchResult}"
                   Margin="0,5,0,0"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
